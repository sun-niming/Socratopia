{"schemaVersion": 1, "cardId": "teyvat.relation.zhongli_furina.002", "canon": "teyvat", "type": "relation", "title": "钟离与芙宁娜", "summary": "钟离认可芙宁娜「与『自我』签订下拯救国家的契约，并严守五百年」的自我践行的正义，称她「依旧是值得被认可的正义之神」。", "evidence": ["与「自我」签订下拯救国家的契约，并严守五百年，最终骗过了天理。", "对于整个枫丹的历史来说…依旧是值得被认可的正义之神。"], "characters": ["zhongli", "furina"], "locations": [], "factions": [], "aliases": ["钟离", "芙宁娜"], "timeRange": {"from": null, "to": "第四章·第五幕"}, "versionRange": {"from": null, "to": "4.2"}, "knowledgeScope": {"level": "public", "allow": [], "deny": []}, "claimType": "derived_summary", "reliability": "primary", "spoilerLevel": "第四章·第五幕", "sources": [{"sourceId": "S015", "url": "https://wiki.biligame.com/ys/钟离语音", "work": "钟离语音", "locator": "网页正文（自动提取）"}, {"sourceId": "S051", "url": "https://wiki.biligame.com/ys/芙宁娜", "work": "芙宁娜", "locator": "网页正文（自动提取）"}]}
