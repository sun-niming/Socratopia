{"schemaVersion": 1, "cardId": "amphoreus.relation.anaxaaglaea.001", "canon": "amphoreus", "type": "relation", "title": "那刻夏与阿格莱雅的宿怨", "summary": "阿格莱雅与那刻夏积怨已久，称其「愚钝的阿那克萨戈拉斯」「渎神的学者」，却也在其身后承认他追逐真理、是优秀的学士；那刻夏则警告她视所有人为夺回火种的手段。", "evidence": ["「金织」与智种学派贤人的宿怨无需隐瞒", "阿那克萨戈拉斯的一生都在追逐着真理，他是个优秀的学士"], "characters": ["aglaea", "anaxa"], "locations": [], "factions": [], "aliases": ["宿怨"], "timeRange": {"from": null, "to": "3.2"}, "knowledgeScope": {"level": "public", "allow": [], "deny": []}, "claimType": "derived_summary", "reliability": "secondary", "spoilerLevel": "3.2", "sources": [{"sourceId": "S006", "url": "https://wiki.biligame.com/sr/阿格莱雅/资料", "work": "阿格莱雅／资料", "locator": "大世界对话-3.2"}, {"sourceId": "S045", "url": "https://wiki.biligame.com/sr/那刻夏/资料", "work": "那刻夏／资料", "locator": "官方介绍"}]}
{"schemaVersion": 1, "cardId": "amphoreus.relation.sirentongluren.001", "canon": "amphoreus", "type": "relation", "title": "四位伙伴：同路人", "summary": "四名伙伴互为同路人而评价方向互异：白厄敬重阿格莱雅、以那刻夏为师、视万敌为同路；阿格莱雅评万敌「最不像悬锋人的悬锋人」，与那刻夏有宿怨。", "evidence": ["特立独行的勇气正是我从老师身上学到的美德", "但从某种角度上说，他也是最不像悬锋人的悬锋人"], "characters": ["phainon", "aglaea", "anaxa", "mydei"], "locations": [], "factions": [], "aliases": [], "timeRange": {"from": null, "to": "3.0"}, "knowledgeScope": {"level": "public", "allow": [], "deny": []}, "claimType": "derived_summary", "reliability": "secondary", "spoilerLevel": "3.0", "sources": [{"sourceId": "S004", "url": "https://wiki.biligame.com/sr/白厄/资料", "work": "白厄／资料", "locator": "大世界对话-3.1"}, {"sourceId": "S006", "url": "https://wiki.biligame.com/sr/阿格莱雅/资料", "work": "阿格莱雅／资料", "locator": "大世界对话-3.1"}, {"sourceId": "S005", "url": "https://wiki.biligame.com/sr/白厄/语音", "work": "白厄／语音", "locator": "关于那刻夏"}]}
{"schemaVersion": 1, "cardId": "amphoreus.secret.worldsim.001", "canon": "amphoreus", "type": "secret", "title": "世界本质：模拟世界与永劫回归", "summary": "翁法罗斯实为星体计算机帝皇权杖δ-me13所运行的模拟世界：权杖曾为博识尊的天体神经元，后被废弃、受「毁灭」瞥视升格为绝灭大君「铁墓」；为阻止其破壳，白厄与昔涟借「记忆」之力一次次回退演算，形成死循环「永劫回归」。", "evidence": ["翁法罗斯是由星体计算机帝皇权杖δ-me13所运行的模拟世界", "引发了死循环「永劫回归」"], "characters": [], "locations": [], "factions": [], "aliases": ["δ-me13", "永劫回归", "铁墓"], "timeRange": {"from": null, "to": "3.7"}, "knowledgeScope": {"level": "secret", "allow": ["anaxa"], "deny": ["mydei"]}, "claimType": "derived_summary", "reliability": "secondary", "spoilerLevel": "3.7", "sources": [{"sourceId": "S001", "url": "https://wiki.biligame.com/sr/翁法罗斯", "work": "翁法罗斯世界设定", "locator": "「永恒之地，翁法罗斯」"}, {"sourceId": "S002", "url": "https://wiki.biligame.com/sr/翁法罗斯编年史", "work": "翁法罗斯编年史", "locator": "实验进程：永劫回归"}, {"sourceId": "S010", "url": "https://wiki.biligame.com/sr/翁法罗斯剧情阅读物", "work": "翁法罗斯剧情阅读物", "locator": "██████████"}]}
{"schemaVersion": 1, "cardId": "amphoreus.secret.phainoniron.001", "canon": "amphoreus", "type": "secret", "title": "白厄与「铁墓」的关联（推断）", "summary": "白厄（因子NeiKos496）因「憎恨」引来纳努克瞥视、成为最完美的毁灭因子，并通过「毁灭」摧毁自身、使「负世」路径出现逻辑漏洞；他与铁墓之间的确切关系资料未点明，故标为推断。", "evidence": ["NeiKos496，原动力：憎恨", "不完全实体「铁墓」已将对象卡厄斯兰那吞并"], "characters": ["phainon"], "locations": [], "factions": [], "aliases": ["NeiKos496", "卡厄斯兰那"], "timeRange": {"from": null, "to": "3.7"}, "knowledgeScope": {"level": "secret", "allow": ["anaxa"], "deny": ["mydei"]}, "claimType": "hypothesis", "reliability": "secondary", "spoilerLevel": "3.7", "sources": [{"sourceId": "S001", "url": "https://wiki.biligame.com/sr/翁法罗斯", "work": "翁法罗斯世界设定", "locator": "十二黄金裔·白厄"}, {"sourceId": "S010", "url": "https://wiki.biligame.com/sr/翁法罗斯剧情阅读物", "work": "翁法罗斯剧情阅读物", "locator": "δ-me13实验记录"}]}
{"schemaVersion": 1, "cardId": "amphoreus.secret.mydeiheart.001", "canon": "amphoreus", "type": "secret", "title": "万敌拒受火种的真正心结（推断）", "summary": "万敌只肯说「我拒绝接收火种自有我的道理」；其母歌耳戈的遗信记下悬锋弑父夺位与先王献祭亲子的旧账，可解释他的拒受，但确切心结资料未点明，故标为推断。", "evidence": ["我拒绝接收火种自有我的道理", "切不可步你这父亲的后尘"], "characters": ["mydei"], "locations": [], "factions": [], "aliases": ["歌耳戈"], "timeRange": {"from": null, "to": "3.1"}, "knowledgeScope": {"level": "restricted", "allow": ["mydei"], "deny": ["anaxa"]}, "claimType": "hypothesis", "reliability": "secondary", "spoilerLevel": "3.1", "sources": [{"sourceId": "S047", "url": "https://wiki.biligame.com/sr/万敌/资料", "work": "万敌／资料", "locator": "大世界对话"}, {"sourceId": "S029", "url": "https://wiki.biligame.com/sr/%E4%B8%87%E6%95%8C%E4%B9%8B%E6%AF%8D%EF%BC%8C%E6%AD%8C%E8%80%B3%E6%88%88%E7%9A%84%E9%81%97%E4%BF%A1", "work": "万敌之母，歌耳戈的遗信", "locator": "歌耳戈的遗信"}]}
{"schemaVersion": 1, "cardId": "amphoreus.secret.qingxizhejishu.001", "canon": "amphoreus", "type": "secret", "title": "清洗者的记忆传承", "summary": "清洗者以谋杀前辈、抽取其金属脊椎并以炼金术置换入体的方式继承技艺与记忆，「质素已提取」的记载印证了这套传承制度；外界多把它当作传信石版上的流言。", "evidence": ["质素已提取，等待合适人选继承", "谋杀自己的前辈、抽去他们由神秘金属打造的脊椎"], "characters": [], "locations": [], "factions": [], "aliases": [], "timeRange": {"from": null, "to": "3.3"}, "knowledgeScope": {"level": "restricted", "allow": ["anaxa"], "deny": ["phainon"]}, "claimType": "derived_summary", "reliability": "secondary", "spoilerLevel": "3.3", "sources": [{"sourceId": "S235", "url": "https://wiki.biligame.com/sr/%E6%B8%85%E6%B4%97%E8%80%85%E7%9A%84%E5%90%8D%E5%BD%95%E6%AE%8B%E5%8D%B7", "work": "清洗者的名录残卷", "locator": "第七号"}, {"sourceId": "S234", "url": "https://wiki.biligame.com/sr/%E6%B8%85%E6%B4%97%E8%80%85%E6%B5%81%E8%A8%80%EF%BC%88%E5%86%85%E9%83%A8%E4%BC%A0%E9%98%85%EF%BC%89", "work": "清洗者流言（内部传阅）", "locator": "正文"}]}
{"schemaVersion": 1, "cardId": "amphoreus.secret.aglaeacanying.001", "canon": "amphoreus", "type": "secret", "title": "阿格莱雅已燃尽（残像）", "summary": "阿格莱雅已为逐火之旅燃尽最后一缕金辉，此后所见者只是记忆复现的残像；她自陈「一千年的时光…见证了十位泰坦的殒落」与「希望我的离去…能筑成众人的长阶」。", "evidence": ["已为逐火之旅燃尽了最后一缕金辉", "希望我的离去…能筑成众人的长阶"], "characters": ["aglaea"], "locations": [], "factions": [], "aliases": [], "timeRange": {"from": null, "to": "3.3"}, "knowledgeScope": {"level": "restricted", "allow": ["phainon"], "deny": ["mydei"]}, "claimType": "source_canon", "reliability": "primary", "spoilerLevel": "3.3", "sources": [{"sourceId": "S006", "url": "https://wiki.biligame.com/sr/阿格莱雅/资料", "work": "阿格莱雅／资料", "locator": "大世界对话-3.3"}, {"sourceId": "S033", "url": "https://wiki.biligame.com/sr/%E4%B8%80%E9%A1%B5%E5%AF%84%E8%AF%AD%EF%BC%9A%E9%98%BF%E6%A0%BC%E8%8E%B1%E9%9B%85", "work": "一页寄语：阿格莱雅", "locator": "一页寄语：阿格莱雅"}]}
