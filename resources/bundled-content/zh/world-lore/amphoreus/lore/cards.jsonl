{"schemaVersion": 1, "cardId": "amphoreus.person.phainon.001", "canon": "amphoreus", "type": "person", "title": "白厄", "summary": "白厄，公开称谓「哀丽秘榭的白厄」，奥赫玛的战士、负世火种的承载者，被伙伴称作「最完美的黄金裔」并被奥赫玛人民奉为救世主；本人自认不及众人，爱好只有战斗与鉴宝。", "evidence": ["「哀丽秘榭的白厄，向你致意。」", "被伙伴们称作最完美的黄金裔，被奥赫玛的人民奉为救世主"], "characters": ["phainon"], "locations": ["ailimixie"], "factions": [], "aliases": ["哀丽秘榭的白厄", "救世主"], "timeRange": {"from": null, "to": "3.7"}, "knowledgeScope": {"level": "public", "allow": [], "deny": []}, "claimType": "derived_summary", "reliability": "secondary", "spoilerLevel": "3.7", "sources": [{"sourceId": "S004", "url": "https://wiki.biligame.com/sr/白厄/资料", "work": "白厄／资料", "locator": "官方介绍／大世界对话"}, {"sourceId": "S032", "url": "https://wiki.biligame.com/sr/%E4%B8%80%E9%A1%B5%E5%AF%84%E8%AF%AD%EF%BC%9A%E7%99%BD%E5%8E%84", "work": "一页寄语：白厄", "locator": "一页寄语：白厄"}]}
