{"schemaVersion": 1, "cardId": "amphoreus.world.overview.001", "canon": "amphoreus", "type": "world", "title": "翁法罗斯：永恒之地", "summary": "「永恒之地」翁法罗斯是被隐藏于深空之中的未知星域，与外界隔绝，寻常星际航行难以察觉其存在；本地居民不知外部世界与星神，只信仰本土神明泰坦。", "evidence": ["「永恒之地」翁法罗斯是被隐藏于深空之中的未知星域", "翁法罗斯的本地人不知外部世界和星神的存在"], "characters": [], "locations": [], "factions": [], "aliases": ["永恒之地"], "timeRange": {"from": null, "to": "3.0"}, "knowledgeScope": {"level": "public", "allow": [], "deny": []}, "claimType": "derived_summary", "reliability": "secondary", "spoilerLevel": "3.0", "sources": [{"sourceId": "S001", "url": "https://wiki.biligame.com/sr/翁法罗斯", "work": "翁法罗斯世界设定", "locator": "「永恒之地，翁法罗斯」"}, {"sourceId": "S002", "url": "https://wiki.biligame.com/sr/翁法罗斯编年史", "work": "翁法罗斯编年史", "locator": "更早的进程"}]}
{"schemaVersion": 1, "cardId": "amphoreus.world.paths.001", "canon": "amphoreus", "type": "world", "title": "三重命途：智识、记忆、毁灭", "summary": "翁法罗斯被「智识」「记忆」「毁灭」三重命途缠裹绑缚，因而难以从外部被观测；因诞生过三位令使级别的存在，故能被忆庭之镜照映出来。", "evidence": ["翁法罗斯被「智识」「记忆」「毁灭」三重命途缠裹绑缚", "因诞生过三位令使级别的存在，故而能被忆庭之镜照映出来"], "characters": [], "locations": [], "factions": [], "aliases": [], "timeRange": {"from": null, "to": "3.0"}, "knowledgeScope": {"level": "public", "allow": [], "deny": []}, "claimType": "derived_summary", "reliability": "secondary", "spoilerLevel": "3.0", "sources": [{"sourceId": "S001", "url": "https://wiki.biligame.com/sr/翁法罗斯", "work": "翁法罗斯世界设定", "locator": "命途"}, {"sourceId": "S002", "url": "https://wiki.biligame.com/sr/翁法罗斯编年史", "work": "翁法罗斯编年史", "locator": "实验进程：无机"}]}
{"schemaVersion": 1, "cardId": "amphoreus.world.titans.001", "canon": "amphoreus", "type": "world", "title": "十二泰坦与四组神职", "summary": "十二泰坦分四组各司其职：支柱三（艾格勒、吉奥里亚、法吉娜）开辟天地，命运三（欧洛尼斯、塔兰顿、雅努斯）编织命运，创生三（墨涅塔、刻法勒、瑟希斯）捏塑生命，灾厄三（扎格列斯、尼卡多利、塞纳托斯）引渡灾祸；另有失名的第十三泰坦德谬歌。", "evidence": ["泰坦自火中降生，三者开辟天地，三者编织命运，三者捏塑生命，三者引渡灾祸", "最初的智种，德谬歌"], "characters": [], "locations": [], "factions": [], "aliases": ["十二泰坦", "泰坦"], "timeRange": {"from": null, "to": "3.0"}, "knowledgeScope": {"level": "public", "allow": [], "deny": []}, "claimType": "derived_summary", "reliability": "secondary", "spoilerLevel": "3.0", "sources": [{"sourceId": "S001", "url": "https://wiki.biligame.com/sr/翁法罗斯", "work": "翁法罗斯世界设定", "locator": "泰坦"}]}
{"schemaVersion": 1, "cardId": "amphoreus.world.goldenblood.001", "canon": "amphoreus", "type": "world", "title": "黄金裔与火种试炼", "summary": "刻法勒献出火种并留下神谕：十二位英雄将击落失神的泰坦、回收火种；通过「火种试炼」者可承袭泰坦神权、攫升为「半神」。这批流淌金血的预言英雄被称为「黄金裔」。", "evidence": ["拥有伟力的英雄开始在大地上行走，他们流淌着金色的神血，被称为「黄金裔」", "若能通过「火种试炼」，便能分得泰坦的力量、承载对应的神权"], "characters": ["phainon", "aglaea", "anaxa", "mydei"], "locations": [], "factions": [], "aliases": ["黄金裔", "火种试炼", "半神"], "timeRange": {"from": null, "to": "3.0"}, "knowledgeScope": {"level": "public", "allow": [], "deny": []}, "claimType": "derived_summary", "reliability": "secondary", "spoilerLevel": "3.0", "sources": [{"sourceId": "S001", "url": "https://wiki.biligame.com/sr/翁法罗斯", "work": "翁法罗斯世界设定", "locator": "社会·黄金裔"}, {"sourceId": "S251", "url": "https://wiki.biligame.com/sr/%E9%98%BF%E6%8F%90%E5%8D%A1%E6%96%AF%E7%9A%84%E5%88%BB%E6%B3%95%E5%8B%92%E8%B0%95%E8%A8%80%E9%9B%86", "work": "阿提卡斯的刻法勒谕言集", "locator": "宣谕篇"}]}
{"schemaVersion": 1, "cardId": "amphoreus.location.okhema.001", "canon": "amphoreus", "type": "location", "title": "奥赫玛", "summary": "奥赫玛是「永恒圣城」，负世泰坦刻法勒庇护下人类最后的避难所，英雄们的逐火之旅在此集结；城中有刻法勒广场、云石市集、瑟希斯信徒的藏书所与法吉娜赐福的云石天宫。", "evidence": ["「奥赫玛」……是人类最后的避难所", "云石市集：奥赫玛居民日常生活的主要区域"], "characters": [], "locations": ["okhema"], "factions": [], "aliases": ["永恒圣城", "圣城"], "timeRange": {"from": null, "to": "3.0"}, "knowledgeScope": {"level": "public", "allow": [], "deny": []}, "claimType": "derived_summary", "reliability": "secondary", "spoilerLevel": "3.0", "sources": [{"sourceId": "S001", "url": "https://wiki.biligame.com/sr/翁法罗斯", "work": "翁法罗斯世界设定", "locator": "城邦·奥赫玛"}, {"sourceId": "S219", "url": "https://wiki.biligame.com/sr/互动文本/翁法罗斯", "work": "互动文本／翁法罗斯", "locator": "「永恒圣城」奥赫玛"}]}
{"schemaVersion": 1, "cardId": "amphoreus.location.xianfeng.001", "canon": "amphoreus", "type": "location", "title": "悬锋城", "summary": "悬锋城是信仰纷争之泰坦尼卡多利的移动要塞与武邦，悬锋人以战斗至死为荣、以严酷纪律闻名于翁法罗斯；鼎盛时的悬锋祭典允许优胜者获得挑战国王的资格。", "evidence": ["「悬锋城」作为信仰纷争之泰坦尼卡多利的武邦", "悬锋人以战斗至死为荣，以严酷纪律闻名于翁法罗斯"], "characters": [], "locations": ["xianfeng"], "factions": [], "aliases": ["悬锋", "武邦", "浴血战端"], "timeRange": {"from": null, "to": "3.0"}, "knowledgeScope": {"level": "public", "allow": [], "deny": []}, "claimType": "derived_summary", "reliability": "secondary", "spoilerLevel": "3.0", "sources": [{"sourceId": "S001", "url": "https://wiki.biligame.com/sr/翁法罗斯", "work": "翁法罗斯世界设定", "locator": "城邦·悬锋城"}, {"sourceId": "S023", "url": "https://wiki.biligame.com/sr/%E6%82%AC%E9%94%8B%E8%AF%B8%E7%8E%8B%E9%80%9A%E9%89%B4", "work": "悬锋诸王通鉴", "locator": "卷之一"}, {"sourceId": "S220", "url": "https://wiki.biligame.com/sr/%E4%BA%94%E5%A4%A7%E7%BE%8E%E5%BE%B7%E4%B8%8E%E7%A5%AD%E5%85%B8%E9%80%9A%E5%91%8A", "work": "五大美德与祭典通告", "locator": "《祭典通告》"}]}
{"schemaVersion": 1, "cardId": "amphoreus.location.yanusapolis.001", "canon": "amphoreus", "type": "location", "title": "雅努萨波利斯", "summary": "雅努萨波利斯是超脱于城邦地缘政治之外的宗教圣地，供奉命运三泰坦、以神谕为业，也是翁法罗斯地理意义上的中心；黄金战争后仅余神殿，被称为「命运重渊」。", "evidence": ["雅努萨波利斯，超脱于城邦地缘政治外的宗教圣地", "如今只剩几座神殿依旧屹立，人们称之为「命运重渊」"], "characters": [], "locations": ["yanusapolis"], "factions": [], "aliases": ["命运重渊", "神谕圣地"], "timeRange": {"from": null, "to": "3.0"}, "knowledgeScope": {"level": "public", "allow": [], "deny": []}, "claimType": "derived_summary", "reliability": "secondary", "spoilerLevel": "3.0", "sources": [{"sourceId": "S001", "url": "https://wiki.biligame.com/sr/翁法罗斯", "work": "翁法罗斯世界设定", "locator": "城邦·雅努萨波利斯"}, {"sourceId": "S224", "url": "https://wiki.biligame.com/sr/%E9%9B%85%E5%8A%AA%E8%90%A8%E6%B3%A2%E5%88%A9%E6%96%AF%E7%A5%AD%E7%A5%80%E6%89%8B%E5%86%8C", "work": "雅努萨波利斯祭祀手册", "locator": "第一章：祭祀时序"}]}
{"schemaVersion": 1, "cardId": "amphoreus.location.shenwushuting.001", "canon": "amphoreus", "type": "location", "title": "神悟树庭", "summary": "神悟树庭建立于巨树枝干之间，是理性之泰坦瑟希斯的学庭，学者在其身旁漫步、醒神与思辨；庭中设七贤分掌七务，首席之位永远留给圣树与理性本身。", "evidence": ["「神悟树庭」即是建立于巨树枝干间的学庭", "七贤者首席之位，永远留给圣树与理性本身"], "characters": [], "locations": ["shuting"], "factions": [], "aliases": ["树庭", "呓语密林", "辉痕圣林"], "timeRange": {"from": null, "to": "3.0"}, "knowledgeScope": {"level": "public", "allow": [], "deny": []}, "claimType": "derived_summary", "reliability": "secondary", "spoilerLevel": "3.0", "sources": [{"sourceId": "S001", "url": "https://wiki.biligame.com/sr/翁法罗斯", "work": "翁法罗斯世界设定", "locator": "城邦·神悟树庭"}, {"sourceId": "S024", "url": "https://wiki.biligame.com/sr/%E4%B8%83%E8%B4%A4%E8%AE%AE%E5%AE%9A%E4%B9%A6", "work": "七贤议定书", "locator": "七贤议定书"}]}
{"schemaVersion": 1, "cardId": "amphoreus.location.stitixia.001", "canon": "amphoreus", "type": "location", "title": "斯缇科西亚", "summary": "斯缇科西亚原为法吉娜庇佑的临水海城，灾变后沉入冥河、沦为亡灵国度；「酣歌海垠」则是被幻乐封闭、以无尽欢宴隔绝苦痛的幻城。", "evidence": ["这个亡灵国度，曾是「巨龙与海浪的城邦」斯缇科西亚", "以幻乐打造的无尽欢宴之城"], "characters": [], "locations": ["stitixia"], "factions": [], "aliases": ["酣歌海垠", "龙骸古城"], "timeRange": {"from": null, "to": "3.3"}, "knowledgeScope": {"level": "public", "allow": [], "deny": []}, "claimType": "derived_summary", "reliability": "secondary", "spoilerLevel": "3.3", "sources": [{"sourceId": "S001", "url": "https://wiki.biligame.com/sr/翁法罗斯", "work": "翁法罗斯世界设定", "locator": "城邦·斯缇科西亚"}, {"sourceId": "S229", "url": "https://wiki.biligame.com/sr/%E6%96%AF%E7%BC%87%E7%A7%91%E8%A5%BF%E4%BA%9A%E9%9A%BE%E6%B0%91%E7%9A%84%E6%97%A5%E5%BF%97", "work": "斯缇科西亚难民的日志", "locator": "【自由月】"}]}
{"schemaVersion": 1, "cardId": "amphoreus.location.chenhunzhiyan.001", "canon": "amphoreus", "type": "location", "title": "晨昏之眼", "summary": "晨昏之眼是栖居天空之泰坦艾格勒神体的空中要塞，天空眷属分晖、雨、冬三部族而争斗不休；阳雷骑士弑杀艾格勒后，残余天空文明来到大地，将浮空废墟留在天际。", "evidence": ["栖居着艾格勒神体的空中要塞", "在阳雷骑士讨伐并弑杀艾格勒后，残余的天空文明来到大地"], "characters": [], "locations": ["chenhun"], "factions": [], "aliases": ["穹顶关塞", "云端遗堡"], "timeRange": {"from": null, "to": "3.3"}, "knowledgeScope": {"level": "public", "allow": [], "deny": []}, "claimType": "derived_summary", "reliability": "secondary", "spoilerLevel": "3.3", "sources": [{"sourceId": "S001", "url": "https://wiki.biligame.com/sr/翁法罗斯", "work": "翁法罗斯世界设定", "locator": "城邦·晨昏之眼"}, {"sourceId": "S231", "url": "https://wiki.biligame.com/sr/%E6%99%A8%E6%98%8F%E5%85%88%E7%A5%96%E4%B9%A6", "work": "晨昏先祖书", "locator": "天上书"}]}
{"schemaVersion": 1, "cardId": "amphoreus.location.ailimixie.001", "canon": "amphoreus", "type": "location", "title": "哀丽秘榭", "summary": "哀丽秘榭是翁法罗斯某处偏僻的村庄，受永夜之帷庇护而遗落世外，麦田、风车与海滨守望着宁静时光；白厄与昔涟出身于此，妖精的隐秘居所「迷路迷境」藏于树洞。", "evidence": ["翁法罗斯某处偏僻的村庄，受永夜之帷庇护而遗落世外", "妖精们的隐秘居所，其入口隐藏在幽深的树洞中"], "characters": ["phainon"], "locations": ["ailimixie"], "factions": [], "aliases": ["妖精织梦的乐园", "迷路迷境"], "timeRange": {"from": null, "to": "3.4"}, "knowledgeScope": {"level": "public", "allow": [], "deny": []}, "claimType": "derived_summary", "reliability": "secondary", "spoilerLevel": "3.4", "sources": [{"sourceId": "S001", "url": "https://wiki.biligame.com/sr/翁法罗斯", "work": "翁法罗斯世界设定", "locator": "城邦·哀丽秘榭"}, {"sourceId": "S028", "url": "https://wiki.biligame.com/sr/%E5%93%80%E4%B8%BD%E7%A7%98%E6%A6%AD%E5%86%9C%E4%BA%8B%E5%8E%86", "work": "哀丽秘榭农事历", "locator": "一月（门关月）"}]}
{"schemaVersion": 1, "cardId": "amphoreus.location.chuangshiwoxin.001", "canon": "amphoreus", "type": "location", "title": "创世涡心与全世矩阵", "summary": "创世涡心是被波涛藏匿的世界起点、寄宿十二泰坦原初神性的圣所，也是神谕中创世奇迹降临之地；无名泰坦大墓「全世矩阵」是至深遗迹，褪去神话修饰后现出巨型储存阵列。", "evidence": ["被波涛藏匿的世界起点，寄宿十二泰坦原初神性的伟大圣所", "褪去了「神话」的修饰，巨型储存阵列明灭不停"], "characters": [], "locations": ["chuangshi"], "factions": [], "aliases": ["创世涡心", "全世矩阵"], "timeRange": {"from": null, "to": "3.7"}, "knowledgeScope": {"level": "public", "allow": [], "deny": []}, "claimType": "derived_summary", "reliability": "secondary", "spoilerLevel": "3.7", "sources": [{"sourceId": "S001", "url": "https://wiki.biligame.com/sr/翁法罗斯", "work": "翁法罗斯世界设定", "locator": "城邦·创世涡心／无名泰坦大墓"}]}
{"schemaVersion": 1, "cardId": "amphoreus.faction.gongmindahui.001", "canon": "amphoreus", "type": "faction", "title": "公民大会与元老院", "summary": "奥赫玛的公民大会实际拥有立法权、人事任免权、宣战与缔和之权，重大城邦事务由其决定；日常由黄金裔领袖与元老院共同主理，元老院负责议程、主持与公布法令。", "evidence": ["公民大会实际拥有立法权、人事任免权、宣战、缔和", "由黄金裔领袖和元老院共同主理奥赫玛城中大小事务"], "characters": ["aglaea"], "locations": [], "factions": ["gongmindahui"], "aliases": ["公民大会", "元老院"], "timeRange": {"from": null, "to": "3.2"}, "knowledgeScope": {"level": "public", "allow": [], "deny": []}, "claimType": "derived_summary", "reliability": "secondary", "spoilerLevel": "3.2", "sources": [{"sourceId": "S025", "url": "https://wiki.biligame.com/sr/%E5%85%B3%E4%BA%8E%E3%80%8C%E5%85%AC%E6%B0%91%E5%A4%A7%E4%BC%9A%E3%80%8D%E7%9A%84%E8%80%83%E5%AF%9F", "work": "关于「公民大会」的考察", "locator": "公民大会的主要职能"}, {"sourceId": "S001", "url": "https://wiki.biligame.com/sr/翁法罗斯", "work": "翁法罗斯世界设定", "locator": "社会·公民大会与元老院"}]}
