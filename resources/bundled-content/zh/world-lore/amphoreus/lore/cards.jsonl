{"schemaVersion": 1, "cardId": "amphoreus.history.heichao.001", "canon": "amphoreus", "type": "history", "title": "黑潮与永夜", "summary": "黑潮自天外来袭，受染者扭曲狰狞、理性丧失，泰坦众神逐一疯溃，大地沉入永夜；唯有奥赫玛凭刻法勒献出火种点亮的黎明机器保有永昼，成为黄金裔集结抗争的净土。", "evidence": ["直至黑潮自天外来袭", "唯有奥赫玛在刻法勒的庇佑下，保有最后一丝光明"], "characters": [], "locations": [], "factions": [], "aliases": ["黑潮", "永夜", "幻灭世"], "timeRange": {"from": null, "to": "3.7"}, "knowledgeScope": {"level": "public", "allow": [], "deny": []}, "claimType": "derived_summary", "reliability": "secondary", "spoilerLevel": "3.7", "sources": [{"sourceId": "S001", "url": "https://wiki.biligame.com/sr/翁法罗斯", "work": "翁法罗斯世界设定", "locator": "生态·黑潮"}, {"sourceId": "S002", "url": "https://wiki.biligame.com/sr/翁法罗斯编年史", "work": "翁法罗斯编年史", "locator": "幻灭世"}]}
{"schemaVersion": 1, "cardId": "amphoreus.culture.guangli.001", "canon": "amphoreus", "type": "culture", "title": "光历与十二月份", "summary": "翁法罗斯以「光历」纪年，一年十二月分属命运季、支柱季、创生季、灾厄季，各月对应一位泰坦；一天分五个时段，末尾的机缘月有时会多出一日闰日（红月）。", "evidence": ["翁法罗斯使用光历纪年", "一月•门关月……代表泰坦：万径之门，雅努斯"], "characters": [], "locations": [], "factions": [], "aliases": ["光历", "门关月", "机缘月"], "timeRange": {"from": null, "to": "3.0"}, "knowledgeScope": {"level": "public", "allow": [], "deny": []}, "claimType": "derived_summary", "reliability": "secondary", "spoilerLevel": "3.0", "sources": [{"sourceId": "S020", "url": "https://wiki.biligame.com/sr/%E7%BF%81%E6%B3%95%E7%BD%97%E6%96%AF%E7%9A%84%E5%8E%86%E6%B3%95", "work": "翁法罗斯的历法", "locator": "月份篇"}, {"sourceId": "S028", "url": "https://wiki.biligame.com/sr/%E5%93%80%E4%B8%BD%E7%A7%98%E6%A6%AD%E5%86%9C%E4%BA%8B%E5%8E%86", "work": "哀丽秘榭农事历", "locator": "哀丽秘榭农事历"}, {"sourceId": "S001", "url": "https://wiki.biligame.com/sr/翁法罗斯", "work": "翁法罗斯世界设定", "locator": "历法／年"}]}
{"schemaVersion": 1, "cardId": "amphoreus.culture.jieqing.001", "canon": "amphoreus", "type": "culture", "title": "吉奥里亚两祭与悬锋祭典", "summary": "翁法罗斯重要祭祀之一是在阿卡索斯城举行的吉奥里亚神秘祭，含耕耘月「苏生祭」与收获月「丰收祭」；悬锋祭典则以勇气、荣耀、理智、坚韧、牺牲五大美德敬奉尼卡多利。", "evidence": ["耕耘月 四月 的「苏生祭」和收获月 八月 的「丰收祭」", "勇气，荣耀，理智，坚韧，牺牲"], "characters": [], "locations": [], "factions": [], "aliases": ["苏生祭", "丰收祭", "悬锋祭典"], "timeRange": {"from": null, "to": "3.0"}, "knowledgeScope": {"level": "public", "allow": [], "deny": []}, "claimType": "derived_summary", "reliability": "secondary", "spoilerLevel": "3.0", "sources": [{"sourceId": "S027", "url": "https://wiki.biligame.com/sr/%E5%90%89%E5%A5%A5%E9%87%8C%E4%BA%9A%E8%8A%82%E6%97%A5%E4%BB%AA%E5%85%B8", "work": "吉奥里亚节日仪典", "locator": "正文"}, {"sourceId": "S220", "url": "https://wiki.biligame.com/sr/%E4%BA%94%E5%A4%A7%E7%BE%8E%E5%BE%B7%E4%B8%8E%E7%A5%AD%E5%85%B8%E9%80%9A%E5%91%8A", "work": "五大美德与祭典通告", "locator": "《祭典通告》"}, {"sourceId": "S001", "url": "https://wiki.biligame.com/sr/翁法罗斯", "work": "翁法罗斯世界设定", "locator": "悬锋与尼卡多利五大美德"}]}
{"schemaVersion": 1, "cardId": "amphoreus.relation.phainonaglaea.001", "canon": "amphoreus", "type": "relation", "title": "白厄与阿格莱雅", "summary": "白厄敬重阿格莱雅并心疼她的疲惫，称「这颗看似空无一物的心，才装得下整个世界的心愿」；阿格莱雅称他为「无缺的英雄」「最完美的黄金裔」，视之为注定的负世者。", "evidence": ["这颗看似空无一物的心，才装得下整个世界的心愿", "…无缺的英雄。时至今日，我也只能如此评价白厄"], "characters": ["phainon", "aglaea"], "locations": [], "factions": [], "aliases": [], "timeRange": {"from": null, "to": "3.3"}, "knowledgeScope": {"level": "public", "allow": [], "deny": []}, "claimType": "derived_summary", "reliability": "secondary", "spoilerLevel": "3.3", "sources": [{"sourceId": "S004", "url": "https://wiki.biligame.com/sr/白厄/资料", "work": "白厄／资料", "locator": "大世界对话-3.1"}, {"sourceId": "S006", "url": "https://wiki.biligame.com/sr/阿格莱雅/资料", "work": "阿格莱雅／资料", "locator": "大世界对话-3.2／3.3"}, {"sourceId": "S005", "url": "https://wiki.biligame.com/sr/白厄/语音", "work": "白厄／语音", "locator": "关于阿格莱雅"}]}
