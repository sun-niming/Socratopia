{
  "title": "Date对象的常用获取方法",
  "definition": "教材列出了Date对象的常用获取方法及其返回含义：getDate()返回天(1-31)，getDay()返回周名(0-6)，getFullYear()返回四位的年(yyyy)，getHours()返回小时(0-23)，getMilliseconds()返回毫秒(0-999)，getMinutes()返回分(0-59)，getMonth()返回月(0-11)，getSeconds()返回秒(0-59)，getTime()返回时间（从1970年1月1日至今）。",
  "key_points": [
    "getDate()：以数值返回天，范围1-31。",
    "getDay()：以数值获取周名，范围0-6。",
    "getFullYear()：获取四位的年。",
    "getHours()：获取小时，范围0-23。",
    "getMilliseconds()：获取毫秒，范围0-999。",
    "getMinutes()：获取分，范围0-59。",
    "getMonth()：获取月，范围0-11。",
    "getSeconds()：获取秒，范围0-59。",
    "getTime()：获取从1970年1月1日至今的时间。"
  ],
  "examples": [
    "new Date().getDate()",
    "new Date().getDay()",
    "new Date().getFullYear()",
    "new Date().getHours()",
    "new Date().getMilliseconds()",
    "new Date().getMinutes()",
    "new Date().getMonth()",
    "new Date().getSeconds()",
    "new Date().getTime()"
  ],
  "misconceptions": [
    "把getMonth()理解成1-12。",
    "把getDay()理解成日期中的“几号”。",
    "把getTime()理解成可直接读的人类日期字符串。"
  ],
  "qa_pairs": [
    {
      "q": "getMonth() 返回的月份范围是多少？",
      "a": "0-11。"
    },
    {
      "q": "getTime() 返回什么？",
      "a": "从1970年1月1日至今的时间。"
    },
    {
      "q": "getDay() 返回什么？",
      "a": "以数值获取周名，范围0-6。"
    }
  ],
