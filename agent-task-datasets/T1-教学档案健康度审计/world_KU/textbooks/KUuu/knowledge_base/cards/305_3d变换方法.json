    "三维缩放方法有 scale3d、scaleX、scaleY、scaleZ。"
  ],
  "examples": [
    "rotate3d(x,y,z,angle)",
    "translate3d(x,y,z)",
    "scale3d(x,y,z)",
    "rotateX(angle)",
    "translateY(y)",
    "scaleZ(z)"
  ],
  "misconceptions": [
